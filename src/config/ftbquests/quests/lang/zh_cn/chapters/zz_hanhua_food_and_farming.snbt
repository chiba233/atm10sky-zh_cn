{
	quest.04D0543FE2820F64.quest_desc: ["该种点线了！其中一些能直接种出线，另一些给的是在配方里等效的替代品。"]
	quest.04D0543FE2820F64.quest_subtitle: "谁还需要蜘蛛呢？"
	quest.04D0543FE2820F64.title: "亚麻绳"
	quest.0500DA5C4D383DC6.quest_desc: ["杀僵尸或者筛泥土就能拿到。"]
	quest.0500DA5C4D383DC6.quest_subtitle: "多吃蔬菜"
	quest.083309154A8974DA.quest_desc: ["最基础的那一档改良。"]
	quest.083309154A8974DA.quest_subtitle: "一点小加成"
	quest.083309154A8974DA.title: "镀金食物"
	quest.0893EFCAC7031FEA.quest_desc: ["现在可以烤蛋糕了，如果你已经准备好了牛奶和鸡蛋。"]
	quest.0893EFCAC7031FEA.quest_subtitle: "鱼与熊掌，我都要"
	quest.0A1C2A7A8617D3E4.quest_subtitle: "速通玩家最爱的东西"
	quest.0A1C2A7A8617D3E4.title: "小麦"
	quest.0A7F53BFE6A4DFDC.quest_desc: ["受够了只能看见自己做得出来的配方？有了它，游戏里每一种食物的做法你都能查。"]
	quest.0A7F53BFE6A4DFDC.quest_subtitle: "烹饪百科全书"
	quest.0A7F53BFE6A4DFDC.title: "无筛选版食谱"
	quest.0AC713AEEBCF2CD2.quest_desc: ["当然你也可以用神秘农业……不过谁会那么干呢？"]
	quest.0AC713AEEBCF2CD2.quest_subtitle: "人道收蛋"
	quest.0AC713AEEBCF2CD2.title: "自动化产蛋"
	quest.0CB4CF33BD96D730.quest_desc: ["高产农业让你通过改动作物的属性来提高产出！（任务稍后补上）"]
	quest.0EFF1AA37772156B.quest_desc: ["这个方块可以为多方块厨房提供水源。\\n\\n通过电缆或管道泵水，还可以提供无限水源。"]
	quest.0EFF1AA37772156B.quest_subtitle: "一个方块就能搞定！"
	quest.0EFF1AA37772156B.title: "水槽 = 无限水源"
	quest.0FE88A567578C720.quest_desc: ["这些都是超级食物，按苹果种类不同，提供的增益也五花八门。"]
	quest.0FE88A567578C720.quest_subtitle: "结晶的苹果"
	quest.12139F09C0F1361D.quest_desc: ["加快生长速度，与绿色肥料冲突。"]
	quest.12139F09C0F1361D.quest_subtitle: "丰产的蘑菇"
	quest.13AFCD3B6F62B986.quest_desc: ["提供冰和雪的配方！"]
	quest.13AFCD3B6F62B986.quest_subtitle: "冰，冰，宝贝！"
	quest.13AFCD3B6F62B986.title: "冰升级"
	quest.1515B32545F51266.quest_desc: ["允许你为炉灶供电。"]
	quest.1515B32545F51266.title: "加热升级"
	quest.1697CC05D08B388D.quest_subtitle: "美味的炸鸡！"
	quest.1697CC05D08B388D.title: "鸡必须走"
	quest.1827DEEA2DF1B144.quest_desc: ["欢迎来到食物与农业章节！\\n\\n在这里，你会发现各种种植和制作食物的方法！"]
	quest.1827DEEA2DF1B144.title: "食物与农业"
	quest.18EADBAFC932F864.quest_desc: ["你需要剪刀来剪羊毛，否则你不会得到羊毛……对吧？"]
	quest.18EADBAFC932F864.quest_subtitle: "和平速通"
	quest.18EADBAFC932F864.title: "剪羊毛时间"
	quest.1B4A74D744F39516.quest_desc: ["去打几片橡树树叶。"]
	quest.1B4A74D744F39516.quest_subtitle: "什么工具都行（拳头也算）"
	quest.1B4A74D744F39516.title: "打掉树叶"
	quest.1D2EF12FD7FDD217.quest_desc: ["鸡会自然下蛋。不过，这真的算自然吗？\\n\\n我想鸡只是在做……&o鸡蛋运动！！！&r。"]
	quest.1D2EF12FD7FDD217.quest_subtitle: "……还是说，其实不是？"
	quest.1D2EF12FD7FDD217.title: "我不会做鸡蛋的双关语"
	quest.1D48298525EEADC9.quest_desc: ["你应该已经拥有了所有需要的东西。"]
	quest.1D48298525EEADC9.quest_subtitle: "给我撒点糖吧！"
	quest.1D48298525EEADC9.title: "你真甜"
	quest.1DCAA0310AA55F1C.quest_desc: ["但他通常下午五点就关门了，所以谁在乎呢？"]
	quest.1DCAA0310AA55F1C.quest_subtitle: "威尔利会为此感到骄傲"
	quest.1DCAA0310AA55F1C.title: "渔夫的开始"
	quest.1E7A4F84CEDBE2AF.quest_desc: ["骨粉是提高产出最基础的办法。"]
	quest.1E7A4F84CEDBE2AF.quest_subtitle: "骨头总得用上"
	quest.1E7A4F84CEDBE2AF.title: "让作物长得更快"
	quest.1F114EB0AAB86DB4.quest_desc: ["市场会为你提供一个村民，如果你有足够的绿宝石，他可以卖给你任何东西。\\n\\n剧透：通常每个物品只需要1个绿宝石，幸运的是，他们有所有东西。"]
	quest.1F114EB0AAB86DB4.quest_subtitle: "村民有不止一种生成方式"
	quest.1F114EB0AAB86DB4.title: "购买农场物资"
	quest.2786D5AC19163524.quest_desc: ["这个方块可以在你的多方块厨房中启用熔炼配方！"]
	quest.2786D5AC19163524.quest_subtitle: "不需要计时器"
	quest.2786D5AC19163524.title: "亲爱的，厨房里有个熔炉"
	quest.28C9EDBF6607E180.quest_desc: ["这个方块是多方块厨房的一部分。\\n\\n它会显示你当前背包或厨房多方块中可用的所有配方。\\n\\n你终于可以在Minecraft中打造一个漂亮的厨房了。"]
	quest.28C9EDBF6607E180.quest_subtitle: "贝蒂·怀特出生在切片面包之前"
	quest.28C9EDBF6607E180.title: "自切片面包以来最好的东西"
	quest.2E9C035EEE7E5C34.quest_desc: ["经典的拴绳。用它把动物带到你的农场区域。\\n\\n这和矿石不一样。"]
	quest.2E9C035EEE7E5C34.quest_subtitle: "让小狗乖一点"
	quest.2E9C035EEE7E5C34.title: "我们用传统方式来做"
	quest.2FBF54AC8273E8DF.quest_desc: ["高产树木加入了大量新树种，每一种都有自己的好东西。打掉树叶就能收获这些果实。"]
	quest.2FBF54AC8273E8DF.quest_subtitle: "水果、水果，还是水果"
	quest.2FBF54AC8273E8DF.title: "丰产树"
	quest.34F29677E6B5E40C.quest_desc: ["提高每次收获的产量，与红色肥料冲突。"]
	quest.34F29677E6B5E40C.quest_subtitle: "丰产的霉菌"
	quest.361DFDB1E1352D6B.quest_desc: ["在一些水旁边找一些甘蔗。"]
	quest.361DFDB1E1352D6B.title: "糖，糖"
	quest.37CA6F9F0226F10E.quest_desc: ["这个方块可以存储用于烹饪的物品。\\n\\n你还可以在上面放置其他厨房多方块物品，比如烤面包机和罐中牛。"]
	quest.37CA6F9F0226F10E.quest_subtitle: "我们需要更多的烹饪空间"
	quest.37CA6F9F0226F10E.title: "需要更多的烹饪空间吗？"
	quest.3EA883C0BB7BD38F.quest_desc: ["让我们收集一些羊毛吧！"]
	quest.3EA883C0BB7BD38F.quest_subtitle: "羊毛不是雪白，是彩虹色？"
	quest.3EA883C0BB7BD38F.title: "玛丽有一只小羊羔"
	quest.43021923E220CF68.quest_desc: ["要将泥土翻耕成农田，你需要一把锄。"]
	quest.43021923E220CF68.quest_subtitle: "等你有了机器再做这个……"
	quest.43021923E220CF68.title: "种植机"
	quest.45F83C2750F70F9B.quest_desc: ["来吧，把一本书放进熔炉里烧掉。"]
	quest.45F83C2750F70F9B.quest_subtitle: "完全不会着火……"
	quest.45F83C2750F70F9B.title: "用书制作厨房"
	quest.460969C070B5C8E5.quest_desc: [
		"要我说，还是合成最省事……"
		"而且到这儿还远没完！"
	]
	quest.460969C070B5C8E5.quest_subtitle: "原版的极限……"
	quest.460969C070B5C8E5.title: "附魔金苹果"
	quest.47764EFC822E462A.quest_desc: ["这个方块会随时间产生牛奶，并为厨房多方块启用牛奶配方。\\n\\n要获得罐中牛，将罐子放在一个洞里。引诱牛掉进洞里，然后在牛上面放一个铁砧。\\n\\n我不知道这个玻璃是用什么做的，但它比我和鸡的关系还要牢固。"]
	quest.47764EFC822E462A.quest_subtitle: "惊人的挤奶神力……却屈居于这斗室之中"
	quest.47764EFC822E462A.title: "罐中牛"
	quest.528304AA09EA8C23.quest_desc: ["一个都不能少！"]
	quest.528304AA09EA8C23.quest_subtitle: "钓个没完"
	quest.528304AA09EA8C23.title: "钓鱼去"
	quest.55C4824DAD905512.quest_desc: ["这个任务由 &6AllTheMods 团队&r 或 &2社区贡献者&r 为 AllTheMods 模组包编写。\\n\\n由于所有 &6AllTheMods&r 包都采用 &e保留所有权利&r 许可，此任务不得在未经 &6AllTheMods 团队&r 明确许可的情况下用于任何非 AllTheMods 团队发布的公共包。\\n\\n此任务故意隐藏，如果你看到这个，说明你正在编辑模式。"]
	quest.58495CFBF4F20CE9.quest_desc: ["这个方块就像厨房柜台，只不过在空中。\\n\\n而且你不能在上面放东西。"]
	quest.58495CFBF4F20CE9.quest_subtitle: "地方大得很，能整的\"活动\"可多了！"
	quest.58495CFBF4F20CE9.title: "更多存储空间"
	quest.58D5BD3106BFD94A.quest_desc: ["制作下一版的书。我向你保证，它值得。\\n\\n我甚至会给你一个钻石作为回报。"]
	quest.58D5BD3106BFD94A.quest_subtitle: "这绝对值得"
	quest.58D5BD3106BFD94A.title: "用钻石的力量烹饪"
	quest.60053279577A59C1.quest_desc: ["受够了一跳起来就把庄稼踩烂？那你有福了！它可以和另外两种肥料一起用。"]
	quest.60053279577A59C1.quest_subtitle: "丰产的黄金"
