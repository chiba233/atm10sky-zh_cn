{
	quest.07BEB974DF1E5AD3.title: "&c下界合金发电机"
	quest.1843C79133DFB024.quest_desc: ["最强大且最高效的发电机，下界之星发电机。猜猜它用什么来产生能量！"]
	quest.1C73E60FC70408D4.quest_desc: ["终于有一个独特的发电机了！烹饪是指食物的艺术。这些发电机不消耗煤炭、熔岩，甚至原木，它们消耗食物。任何有饱食度的东西都可以用来产生能量，产生的能量量基于食物所含的饱食度。牛排会比胡萝卜提供更多能量。"]
	quest.40DB6E3DE87F16EF.title: "&5口臭发电机"
	quest.68972BA647FDCF8F.title: "&6蜂蜜发电机"
	quest.69201157ECFBB426.quest_desc: ["最烦的就是：辛辛苦苦弄了个&5末影人&r农场，本来想刷经验或神化宝石，到末了净是一堆&3末影珍珠&r（嘿嘿，末了，&3末影珍珠&r）。现在这些&3末影珍珠&r可以拿去&3末影发电机&r里换成能量了。你甚至可以做&a末影之眼&r来换更多能量！"]
	quest.69201157ECFBB426.title: "&3末影发电机"
	quest.6A1145678E80FB8E.quest_desc: ["外面有这么多没用的&5附魔&r，为什么不用它们来获取一些能量呢！&b魔咒发电机&r使用&5附魔书&r来制造能量。&5附魔书&r的等级和稀有度会影响你从中获得的能量量。"]
	quest.6A1145678E80FB8E.title: "&b魔咒发电机"
	quest.7297391D026EE9A6.quest_desc: ["想要一些刺激和新颖的东西来制造能量？用&d药水&r怎么样！这就是&d药水发电机&r所做的，它会拿走你的&d药水&r并根据其强度和持续时间来制造能量。"]
	quest.7297391D026EE9A6.title: "&d药水发电机"
}
