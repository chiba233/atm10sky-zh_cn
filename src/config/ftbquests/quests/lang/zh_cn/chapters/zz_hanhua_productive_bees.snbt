	quest.176ACC61DC206E55.quest_desc: [
		"这些蜜蜂可以在绯红森林找到。种植绯红菌时也有 2% 的几率获得它们的蜂巢。"
	]
	quest.1ACB3EDBCB732514.quest_subtitle: "将一个独居石块喂给硫蜜蜂"
	quest.2982D38BD5EE6349.quest_desc: [
		"这些蜜蜂在诡异森林里游荡。种植诡异菌时也有 2% 的几率获得它们的蜂巢。"
	]
	quest.371E09ED2A3F6BDC.quest_desc: [
		"在晚上！"
	]
	quest.3E301F3EEC8C763A.quest_desc: [
		"这可用于加快幼蜂的生长速度，或制作新的刷怪蛋。"
		""
		"放入一个装有幼蜂的蜂笼和20个蜜蜂小食，可以让幼蜂长成成年蜜蜂。"
		""
		"要制作刷怪蛋，你需要先把目标蜜蜂的基因与蜜蜂小食结合，再将这个蜜蜂小食和鸡蛋放入孵化器，制成对应的蜜蜂刷怪蛋。\\n\\n基因样本可以相互合并，纯度最高为100%；纯度达到100%时，鸡蛋转化为蜜蜂刷怪蛋的成功率也是100%。"
		"{@pagebreak}"
		"你甚至可以直接给蜂笼中的蜜蜂应用基因，而无需将其取出。把带有所需基因样本的蜜蜂小食和装有目标蜜蜂的蜂笼一起放入小蜜蜂孵化器即可。"
	]
	chapter.1D42B373285DEF81.chapter_subtitle: ["以及高效金属加工"]
}
