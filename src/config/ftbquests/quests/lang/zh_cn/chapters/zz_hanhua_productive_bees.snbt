	quest.4FE7F45C72EF5DC1.title: "镍蜜蜂"
	quest.500BEAD94C97DF96.quest_desc: ["可放置在蜂箱或离心机中。\\n\\n在蜂箱中时，可减少蜜蜂在蜂箱中停留时间的20%。\\n\\n在离心机中时，可提高处理速度。\\n\\n这些效果可叠加。"]
	quest.500BEAD94C97DF96.quest_subtitle: "音速蜜蜂"
