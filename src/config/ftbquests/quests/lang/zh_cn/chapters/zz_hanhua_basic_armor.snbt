	]
	quest.351159C55159C316.quest_subtitle: "末地城箱子"
	quest.351159C55159C316.title: "尖塔盔甲纹饰"
	quest.3512F47DADC07EAE.quest_desc: ["&5难得素盔甲&r，但增强了&d&l新生魔艺&r法术的效果！"]
