	quest.62161BDE9AAAA4BF.quest_subtitle: "遗迹"
	quest.62161BDE9AAAA4BF.title: "向导盔甲纹饰"
	quest.65A529C8238E89F1.quest_desc: ["感谢&5&l通用机械&r，我们现在可以用&9青金石&r制作盔甲了！\\n\\n不过说实话，它有点烂……"]
	quest.65A529C8238E89F1.quest_subtitle: "9"
