	quest.7279700A93E8630B.title: "&5难得素&r"
	quest.729DCB919A92B735.quest_desc: [
		"也可以从荒野旋风人身上获得"
		"{image:atm:textures/questpics/basicarmor/armor_bolt.png width:100 height:150 align:center}"
	]
	quest.729DCB919A92B735.quest_subtitle: "试炼密室"
	quest.729DCB919A92B735.title: "镶铆盔甲纹饰"
	quest.72DDA413D73E3235.quest_desc: ["作为&6&lATM&r盔甲系列的下一个等级，&3振金&r盔甲在所有属性上都有大幅提升！\\n\\n你需要先拥有&6ATM盔甲&r才能制作它。"]
	quest.72DDA413D73E3235.quest_subtitle: "32"
	quest.72DDA413D73E3235.title: "&3振金盔甲"
	quest.76CDF08465700AA2.quest_desc: [
		"也可以从被附身的监守者身上获得"
		"{image:atm:textures/questpics/basicarmor/armor_silent.png width:100 height:150 align:center}"
	]
	quest.76CDF08465700AA2.quest_subtitle: "远古城市"
	quest.76CDF08465700AA2.title: "幽静盔甲纹饰"
	quest.79D3055DE0EEA6B0.quest_desc: [
		"&d&l元素魔艺&r的&c火焰&r盔甲！\\n"
		"这套装备会强化&c火焰&r系魔符，让火属性法术威力更强。\\n\\n它提供&c火焰&r伤害抗性，穿齐整套时抗性更高。\\n\\n凑齐整套之后，还会把一部分受到的&c火焰&r系伤害转化为魔力。"
	]
	quest.79D3055DE0EEA6B0.quest_subtitle: "15"
	quest.79D3055DE0EEA6B0.title: "&c炽焰术士套装"
	quest.7B500E0577BDFF8F.quest_desc: ["&6青铜&r是&6铜&r和锡的合金。\\n\\n制作这种合金的方法有很多种，我不会告诉你正确的方法。"]
	quest.7B500E0577BDFF8F.quest_subtitle: "18"
	quest.7B500E0577BDFF8F.title: "&6青铜盔甲"
	quest.7C1D407CF67786F6.quest_desc: [
		"&d&l元素魔艺&r的&e气&r盔甲！\\n"
		"强化&e气&r系魔符，对闪电类和「跃进」这类位移法术很有用。\\n\\n减免来自&e气&r系的伤害。穿齐整套时，还会把一部分受到的&e气&r系伤害转化为魔力。"
	]
	quest.7C1D407CF67786F6.quest_subtitle: "15"
	quest.7C1D407CF67786F6.title: "&f气岚法师套装"
	quest.7F11ABFB2E21B7E4.quest_desc: ["盔甲是&l&2Minecraft&r中非常重要的一部分，它能保护你免受伤害。\\n\\n不同的盔甲部件提供不同的护甲值。这决定了盔甲的效果，越多越好！\\n\\n大多数盔甲都可以通过盔甲纹饰来改变外观进行装饰，使用一件带有盔甲纹饰的盔甲和一个用于染色的物品即可改变外观！"]
	quest.7F11ABFB2E21B7E4.title: "&l&b基础盔甲&r"
	quest.7FABB77A60E7962C.quest_desc: ["通过将黑曜石与&b钻石&r融合，我们可以得到强化黑曜石粉！\\n\\n然后，我们可以将&7锇&r压缩进去，使其成为锭的形式。\\n\\n之后，我们可以将这些锭制成盔甲，其属性甚至比&6ATM盔甲&r更好！"]
	quest.7FABB77A60E7962C.quest_subtitle: "31"
	quest.7FABB77A60E7962C.title: "&5强化黑曜石盔甲"
