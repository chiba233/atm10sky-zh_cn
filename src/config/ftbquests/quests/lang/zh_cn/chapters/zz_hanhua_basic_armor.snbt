	quest.1E3E688B3B52C4D2.quest_subtitle: "古迹废墟"
	quest.1E3E688B3B52C4D2.title: "牧民盔甲纹饰"
	quest.1EABF2E7AE7B8F22.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_netherite.png width:100 height:150 align:center}"]
	quest.1EABF2E7AE7B8F22.title: "&8下界合金&r"
	quest.1FAE4A884E083283.quest_desc: ["&d&l禁忌与奥秘&r模组的&6战神提尔&r盔甲是该模组防御最强的装备，防护和耐久都很出色。它由&5天龙神秘&r盔甲升级而来，需要模组后期的&6锻炉&r才能打造。"]
	quest.1FAE4A884E083283.title: "&6战神提尔盔甲"
	quest.1FC7ABEAB5018E79.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_redstone.png width:100 height:150 align:center}"]
	quest.1FC7ABEAB5018E79.title: "&4红石&r"
	quest.211FD55DEB635A98.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_copper.png width:100 height:150 align:center}"]
	quest.211FD55DEB635A98.title: "&6铜&r"
	quest.2296CE4418AE62D4.quest_desc: ["&6ATM盔甲&r，但对&d&l新生魔艺&r法术有增益效果！"]
	quest.2296CE4418AE62D4.quest_subtitle: "24"
	quest.2296CE4418AE62D4.title: "&6ATM奥术师装备"
	quest.243008D4DCD789D0.quest_desc: [
		"也可以让荒野魔灵替你铸造"
		"{image:atm:textures/questpics/basicarmor/armor_wild.png width:100 height:150 align:center}"
	]
	quest.243008D4DCD789D0.quest_subtitle: "丛林神庙"
	quest.243008D4DCD789D0.title: "荒野盔甲纹饰"
	quest.28408BFAA54E4FC6.quest_desc: ["&7皮革盔甲&r是原版里你能拿到的最差的一套。\\n\\n这多半是因为&c&lMojang&r本来就指望你在别的盔甲之前先穿它。\\n\\n可我几乎从来不做，因为我总是凑不出那么多&8奶&f牛&r，对不住了&c&lMojang&r！"]
	quest.28408BFAA54E4FC6.quest_subtitle: "7"
	quest.28408BFAA54E4FC6.title: "&7皮革盔甲"
	quest.2A4FE9644F3B9DC1.quest_desc: ["&2初级精华&r的升级版本。"]
	quest.2A4FE9644F3B9DC1.quest_subtitle: "26"
	quest.2A4FE9644F3B9DC1.title: "&c中级精华盔甲"
	quest.2AC0FE608759AD53.quest_desc: ["&e&l机械动力&r的潜水装备不只是护甲，还会在水下建造和作业时给你一大堆增益。"]
	quest.2AC0FE608759AD53.quest_subtitle: "7 到 15"
	quest.2AC0FE608759AD53.title: "&9潜水装备"
	quest.2E0F82F7E1B74033.quest_desc: [
		"&d&l元素魔艺&r的&2大地&r盔甲！\\n"
		"它会强化&2大地&r系魔符，提升土属性与毒属性法术的效果。\\n\\n它能减免来自&2大地&r系的伤害。\\n\\n凑齐整套之后，还会把一部分受到的&2大地&r系伤害转化为魔力。"
	]
	quest.2E0F82F7E1B74033.quest_subtitle: "15"
	quest.2E0F82F7E1B74033.title: "&2厚土法师套装"
	quest.2EAA6BE598C83F24.quest_desc: [
		"&d&l元素魔艺&r的&3水&r盔甲！\\n"
		"它会强化&3水&r系魔符。\\n\\n它能减免来自&3水&r系的伤害。\\n\\n凑齐整套之后，还会把一部分受到的&3水&r系伤害转化为魔力。"
	]
	quest.2EAA6BE598C83F24.quest_subtitle: "15"
	quest.2EAA6BE598C83F24.title: "&3碧水法师套装"
	quest.338BD467EBE6EE1F.quest_desc: [
		"也可以从荒野唤魔者身上获得"
		"{image:atm:textures/questpics/basicarmor/armor_sentry.png width:100 height:150 align:center}"
	]
	quest.338BD467EBE6EE1F.quest_subtitle: "掠夺者前哨站"
	quest.338BD467EBE6EE1F.title: "哨兵盔甲纹饰"
	quest.3403D7502F7BC897.quest_desc: ["字面意义上的无敌，没有任何东西能打中你并造成伤害。\\n\\n目前你需要拿&e量子&b升级&r去升级&c下界合金盔甲&r，不过&6&lATM 团队&r的朋友们正忙着把这个配方改得更难！\\n\\n而且你拦不住他们！&l哇哈哈哈哈哈"]
	quest.3403D7502F7BC897.quest_subtitle: "无敌"
	quest.3403D7502F7BC897.title: "&e量子&b盔甲&r (&l&7MI&r)"
	quest.34D14B807A2DAC0F.quest_desc: ["你以为好玩的事只有&5&l通用机械&r和&l&7现代工业化&r能占着？\\n\\n这套&5量子盔甲&r的基础属性和&c下界合金盔甲&r接近，但它和&aMekaSuit&r一样，能拿能量当护盾用。\\n它还能装升级件，让你更上一层楼！比如飞行、夜视，甚至自动充能。\\n\\n不过最妙的是它能和你的存储系统绑定！绑定之后，无论你在哪儿，都能自动从系统里取电、取任何物品。\\n\\n此外，穿齐整套还能让你不被&a辐射&r弄死。"]
	quest.34D14B807A2DAC0F.quest_subtitle: "你能提供的尽可能多的能量"
	quest.34D14B807A2DAC0F.title: "&5量子盔甲&r (&l&bAE2&r)"
