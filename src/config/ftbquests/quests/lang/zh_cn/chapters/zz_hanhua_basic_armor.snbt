	quest.68DABFFB6B3E1A57.title: "眼眸盔甲纹饰"
	quest.6B671CB07D046BEC.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_diamond.png width:100 height:150 align:center}"]
	quest.6B671CB07D046BEC.title: "&b钻石&r"
	quest.6C5F9D0D447EFB9C.quest_desc: ["你以为我们只有&l&2原版&r吗？\\n\\n&6ATM盔甲&r拥有更高的护甲值和盔甲韧性，以及对魔法的额外抗性和其他增益，你可以在&6&lATM&r任务页面阅读详情！\\n\\n顺便说一句，你需要&c下界合金&r来制作它。"]
	quest.6C5F9D0D447EFB9C.quest_subtitle: "24"
	quest.6C5F9D0D447EFB9C.title: "&6ATM盔甲"
	quest.6D45C78AD098AF87.quest_desc: ["这是一套高度特化的盔甲，用来防电击危害，而不是拿去&4战斗&r扛伤害。它相当于一个「法拉第笼」，让你免疫&7电线&r和&e特斯拉线圈&r。"]
	quest.6D45C78AD098AF87.title: "&7法拉第盔甲"
	quest.6F76DA3BBAE8337B.quest_desc: ["我们能从&6&lATM&r获得的最好盔甲，&5难得素&r！\\n\\n现在拥有100%击退抗性和全方位的更高属性！\\n\\n并且需要&3振金盔甲&r来制作。"]
	quest.6F76DA3BBAE8337B.quest_subtitle: "40"
	quest.6F76DA3BBAE8337B.title: "&5难得素盔甲"
	quest.71C552678A0F649F.quest_desc: ["&7锇&r生成在深板岩附近，只需要铁镐即可开采，但它的属性比&c下界合金&r更好！"]
	quest.71C552678A0F649F.quest_subtitle: "21"
	quest.71C552678A0F649F.title: "&7锇盔甲"
