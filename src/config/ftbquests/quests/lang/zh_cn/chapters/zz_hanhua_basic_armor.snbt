	]
	quest.39796D8EE440F318.quest_subtitle: "沙漠神殿"
	quest.39796D8EE440F318.title: "沙丘盔甲纹饰"
	quest.3A840658A11D16A5.quest_desc: ["&7气动工艺&r的&7气动&r盔甲是一套强力的后期模块化装备，靠你压力网络里的压缩空气驱动。这套装备最精彩的地方是它的升级件：你能飞得比量子盔甲还快、跳得高得离谱，还能免疫五花八门的伤害。"]
	quest.3A840658A11D16A5.title: "&7气动盔甲"
	quest.3AA836E8EDB52097.quest_desc: ["{image:atm:textures/questpics/basicarmor/armor_lapis.png width:100 height:150 align:center}"]
	quest.3AA836E8EDB52097.title: "&9青金石&r"
	quest.3ABE7074E500494D.quest_desc: ["&7钢&r用于&5&l通用机械&r中的大多数机器……加上盔甲也不错！"]
	quest.3ABE7074E500494D.quest_subtitle: "20"
	quest.3ABE7074E500494D.title: "&5&l通用机械&r &7钢盔甲"
	quest.3AE0198177A8E91B.quest_desc: [
		"也可以从被附身的远古守卫者身上获得"
